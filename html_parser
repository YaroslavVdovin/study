from urllib.parse import urlparse

import bs4
import requests
import matplotlib.pyplot as plt
from datetime import datetime
from multiprocessing import Pool
import urllib

fig_dict = {}

plot_dicts = {}

def parse_html(link):
    res = requests.get(link)
    soup = bs4.BeautifulSoup(res.text, 'html.parser')
    table_raw = soup.find_all('table', {'class': 'mfd-table mfd-currency-table'})
    t_content = []
    short_url = urlparse(link).netloc

    for t in table_raw:
        t_content.append(t.find_all('td'))

    date_list = [datetime.strptime(j.text[2:], "%d.%m.%Y").strftime("%Y-%m") for i in t_content for j in i if
                j.text[0] == 'с']

    value_list = [float(j.text) for i in t_content for j in i if j.text[0].isdigit()]

    currency_list = list(zip(date_list, value_list))

    plot_dict = {i: [] for i in list(set(date_list))}


    for i in plot_dict.keys():
        for j in currency_list:
            if i == j[0]:
                plot_dict[i].append(j[1])

    for i in plot_dict.keys():
        plot_dict[i] = sum(plot_dict[i]) / len(plot_dict[i])

    return {short_url:plot_dict}

def plotting(raw_plot_dict):
    for source, plot_data in raw_plot_dict.items():
        sorted_dates = sorted(plot_data.keys())
        fig, ax = plt.subplots()
        ax.plot(sorted_dates, [plot_data[cur] for cur in sorted_dates])
        plt.title("Средний месячный курс RUR/USD")
        plt.xlabel("Месяц/год")
        plt.ylabel("Курс USD")
    return {source:fig}

if __name__ == '__main__':
    links = ['https://mfd.ru/currency/?currency=USD']
    with Pool(processes=len(links)) as plotter:
        results = plotter.map(parse_html,links)

    for res in results:
        fig_dict.update(plotting(res))


    for fig_name in fig_dict.keys():
        fig = fig_dict[fig_name]  # Достаем объект фигуры

    print(fig_dict)
    for title, fig in fig_dict.items():
        plt.show()
        fig.savefig(f"{title}.png")
